# stdio only; HTTP never falls back to these credentials
EDSHOP_LOGIN=
EDSHOP_PASSWORD=
EDSHOP_ESHOP_LOGIN=
EDSHOP_ESHOP_PASSWORD=
# Additional exact hostnames for an HTTPS reverse proxy (comma-separated)
EDSHOP_ALLOWED_HOSTS=
# Maximum running SOAP calls per process; overload fails fast (no response byte cap)
EDSHOP_MAX_CONCURRENT_CALLS=2

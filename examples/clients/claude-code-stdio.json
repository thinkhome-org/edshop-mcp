{
  "mcpServers": {
    "edshop": {
      "type": "stdio",
      "command": "/ABSOLUTE/PATH/edshop-mcp/.venv/bin/edshop-mcp",
      "args": ["--transport", "stdio"],
      "env": {
        "EDSHOP_LOGIN": "${EDSHOP_LOGIN:-}",
        "EDSHOP_PASSWORD": "${EDSHOP_PASSWORD:-}"
      },
      "timeout": 120000
    }
  }
}
